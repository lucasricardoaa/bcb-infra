# .env.example
# Copie este arquivo para .env e preencha os valores para uso local.
# NUNCA versione o arquivo .env — ele está no .gitignore.
#
# Este arquivo é usado apenas para desenvolvimento local.
# Em CI/CD (GitHub Actions), as credenciais são obtidas via OIDC — sem secrets estáticos.

# Perfil AWS CLI a usar localmente (alternativa ao par key/secret)
# AWS_PROFILE=seu-perfil-aws

# Credenciais AWS (use apenas se não estiver usando AWS_PROFILE)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Região padrão
AWS_DEFAULT_REGION=us-east-1

# Conta AWS do portfólio
AWS_ACCOUNT_ID=992382708036

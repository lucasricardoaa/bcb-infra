{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3StagingRead",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::bcb-pipeline-staging",
        "arn:aws:s3:::bcb-pipeline-staging/*"
      ]
    },
    {
      "Sid": "S3WarehouseReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetBucketLocation",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::bcb-warehouse",
        "arn:aws:s3:::bcb-warehouse/*"
      ]
    },
    {
      "Sid": "GlueDataCatalog",
      "Effect": "Allow",
      "Action": [
        "glue:GetDatabase",
        "glue:GetDatabases",
        "glue:GetTable",
        "glue:GetTables",
        "glue:GetPartition",
        "glue:GetPartitions",
        "glue:BatchGetPartition",
        "glue:CreateTable",
        "glue:UpdateTable",
        "glue:DeleteTable",
        "glue:CreatePartition",
        "glue:BatchCreatePartition",
        "glue:UpdatePartition",
        "glue:DeletePartition",
        "glue:BatchDeletePartition"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:${account_id}:catalog",
        "arn:aws:glue:us-east-1:${account_id}:database/bcb_pipeline",
        "arn:aws:glue:us-east-1:${account_id}:table/bcb_pipeline/*",
        "arn:aws:glue:us-east-1:${account_id}:database/bcb_warehouse",
        "arn:aws:glue:us-east-1:${account_id}:table/bcb_warehouse/*"
      ]
    },
    {
      "Sid": "CloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:${account_id}:log-group:/aws-glue/*"
    }
  ]
}
